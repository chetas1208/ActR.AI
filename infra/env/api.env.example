# ActR.AI API — Environment Variable Reference
# Set these in Vercel project settings for actr-ai-api
# DO NOT commit real secrets

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=production
APP_NAME=actr-ai-api
APP_BASE_URL=https://actr-ai-api.vercel.app
FRONTEND_BASE_URL=https://actr-ai-web.vercel.app
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=https://actr-ai-web.vercel.app
WEBHOOK_SECRET=<strong-random-secret>
ENABLE_DEBUG_ROUTES=false
ENABLE_PROVIDER_STATUS_ENDPOINT=true

# ── Tigris Object Storage ─────────────────────────────────────
TIGRIS_BUCKET=actr-ai
TIGRIS_ENDPOINT=https://t3.storage.dev
AWS_ACCESS_KEY_ID=<your-tigris-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-tigris-secret-access-key>
AWS_REGION=auto
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_BYTES=524288000
MAX_DIRECT_FILE_BYTES=524288000
PRESIGNED_UPLOAD_TTL_SECONDS=900
PRESIGNED_DOWNLOAD_TTL_SECONDS=3600

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@<host>.database.insforge.app:5432/insforge?sslmode=require
# INSFORGE_API_URL=https://<project>.insforge.dev
# INSFORGE_API_KEY=<your-insforge-api-key>
USE_IN_MEMORY_DB=false

# ── YouTube Data API (optional) ──────────────────────────────
YOUTUBE_API_KEY=<your-youtube-data-api-key>

# ── NVIDIA NIM (required for GenAI) ──────────────────────────
# Get your key at https://build.nvidia.com/
NIM_API_KEY=<your-nvidia-nim-api-key>
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_FAST_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
NIM_CODING_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_TIMEOUT_SECONDS=60

# ── NVIDIA ASR (optional — enables auto-transcription) ────────
# Defaults to NIM_API_KEY if NVIDIA_ASR_API_KEY is empty
# NVIDIA_ASR_API_KEY=
NVIDIA_ASR_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ASR_MODEL=nvidia/parakeet-1.1b-rnnt-multilingual-asr
NVIDIA_ASR_LANGUAGE=en
NVIDIA_ASR_TIMEOUT_SECONDS=120

# Transcription provider: "nvidia" (preferred) | "local_whisper" (dev only)
TRANSCRIPTION_PROVIDER=nvidia
LOCAL_TRANSCRIPTION_ENABLED=false
LOCAL_WHISPER_MODEL_PATH=
LOCAL_WHISPER_SERVER_URL=

# ── Daytona (safe code execution) ────────────────────────────
DAYTONA_API_KEY=<your-daytona-api-key>
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_DEFAULT_IMAGE=ubuntu:22.04
DAYTONA_COMMAND_TIMEOUT_SECONDS=60
DAYTONA_DELETE_SANDBOX_AFTER_RUN=true

# ── Rtrvr.ai (browser automation & source research) ──────────
RTRVR_API_KEY=<your-rtrvr-api-key>
RTRVR_API_URL=https://api.rtrvr.ai
RTRVR_MODE=cloud
RTRVR_TIMEOUT_SECONDS=120

# ── Workflow ─────────────────────────────────────────────────
WORKFLOW_AUTO_ADVANCE=true
WORKFLOW_STEP_TIMEOUT_SECONDS=60
WORKFLOW_MAX_RETRIES=1
