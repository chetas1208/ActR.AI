# ActR.AI Web — Environment Variable Reference
# Set these in Vercel project settings for actr-ai-web

NUXT_PUBLIC_APP_NAME=ActR.AI
NUXT_PUBLIC_APP_URL=https://actr-ai-web.vercel.app
NUXT_PUBLIC_API_BASE_URL=https://actr-ai-api.vercel.app

NUXT_PUBLIC_ENABLE_YOUTUBE_INPUT=true
NUXT_PUBLIC_ENABLE_UPLOAD_INPUT=true
NUXT_PUBLIC_ENABLE_DIRECT_FILE_INPUT=true
NUXT_PUBLIC_ENABLE_RTRVR_RESEARCH=true
NUXT_PUBLIC_ENABLE_DAYTONA_EXECUTION=true
NUXT_PUBLIC_ENABLE_NVIDIA_AI=true

NUXT_PUBLIC_WORKFLOW_POLL_INTERVAL_MS=2000
NUXT_PUBLIC_WORKFLOW_AUTO_ADVANCE=true
