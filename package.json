{
  "name": "gorube-flow",
  "private": true,
  "version": "1.0.0",
  "description": "Gorube Flow – video-to-agent workflow engine built on GoTube",
  "scripts": {
    "dev:web": "pnpm --filter @gorube/web dev",
    "build:web": "pnpm --filter @gorube/web build",
    "dev:all": "pnpm --parallel --filter './apps/*' dev"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
